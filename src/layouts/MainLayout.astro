---
// Stylesheet import
import "@sass/main.scss";

// Type imports
import type { HTMLAttributes } from "astro/types";

// Component imports
import BaseHead from "../components/atomic/BaseHead.astro";
import SkipNavLink from "@/components/utilities/SkipNavLink.astro";

interface Props extends HTMLAttributes<"html"> {
  title?: string;
  description?: string;
  image?: string;
}
---

<html lang="en">
  <BaseHead {...Astro.props} />
  <SkipNavLink />
  <body data-brand="primary">
    <main id="main">
      <slot />
    </main>
  </body>
</html>
