---
// Type imports
import type { HTMLAttributes } from "astro/types";
import type { Variant } from "@/domain/filters";

// Component imports
import RadioButton from "@components/ui/RadioButton.astro";
import ClearButton from "@components/ui/ClearButton.astro";

// Props
interface Props extends HTMLAttributes<"div"> {
  variant: Variant;
  options: number[];
  classes?: string;
}

const { variant, options, classes } = Astro.props;

const anchorName = `--menu-button-${variant}`;
---

<div class:list={["filter-menu", classes]} id=`filter-menu-${variant}` popover>
  <fieldset>
    <legend class="visually-hidden"
      >Set a maximum {variant} time. Applying a filter will change the listed recipes</legend
    >
    {options.map((o) => <RadioButton variant={variant} option={o} />)}
  </fieldset>
  <ClearButton variant={variant} />
</div>

<style lang="scss" define:vars={{ anchorName }}>
  .filter-menu {
    width: 15rem;
    background-color: var(--bg-container-default);
    border-radius: var(--size-8);
    border: var(--border-default);
    box-shadow: var(--bs-filter-menu);
    padding: var(--pad-cont-sm);
    top: anchor(var(--anchorName) bottom);
    left: anchor(var(--anchorName) left);
    margin-block-start: var(--size-8);

    &.sticky {
      position-anchor: --site-header;
      top: anchor(bottom);
      left: anchor(var(--anchorName) left);
    }

    fieldset {
      display: flex;
      flex-direction: column;
      border: none;
    }
  }
</style>
