---
// Component imports
import Wrapper from "@components/utilities/Wrapper.astro";
import PrimaryNav from "@components/layout/navigation/PrimaryNav.astro";

// Asset imports
import Logo from "@icons/logo.svg";
---

<header>
  <Wrapper width="wide">
    <div class="layout">
      <a href="/"
        ><span class="visually-hidden">Back to home</span>
        <Logo class="logo" />
      </a>
      <PrimaryNav />
    </div>
  </Wrapper>
</header>

<style lang="scss">
  @use "@sass/miscellaneous" as *;

  header {
    position: sticky;
    z-index: 1;
    top: 0;
    width: 100%;
    background-color: var(--bg-container-header);
    padding-block-start: var(--size-16-32-20);
    padding-block-end: var(--size-16-20-20);
    border-block-end: var(--border-default);

    .layout {
      display: grid;
      grid-template-columns: 1fr 2fr;
      align-items: center;

      @include mq(large, max) {
        grid-template-columns: 1fr auto;
      }
    }

    .logo {
      display: block;
      width: var(--size-logo-md);
    }
  }
</style>
