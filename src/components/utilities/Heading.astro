---
// Type imports
import type { HTMLAttributes } from "astro/types";

const sizes = {
  h1: "h1",
  h2: "h2",
  h3: "h3",
  h4: "h4",
  h5: "h5",
  h6: "h6",
};

interface Props extends HTMLAttributes<keyof typeof sizes> {
  tag: keyof typeof sizes;
  size: keyof typeof sizes;
  text: string;
  highlighted?: string;
  classes?: string;
}

const { tag, size, text, highlighted, classes, ...rest } = Astro.props;
const CustomTag = tag;
---

<CustomTag class:list={["heading", sizes[size], classes]} {...rest}>
  {highlighted ? <span class="highlighted">{highlighted}</span> : ""}
  {text}
</CustomTag>

<style lang="scss">
  .heading {
    color: var(--fg-text-strong);
    text-wrap: balance;
    &.h1 {
      font: var(--font-1);
      letter-spacing: var(--ls-xs);
    }
    &.h2 {
      font: var(--font-2);
      letter-spacing: var(--ls-xs);
    }
    &.h3 {
      font: var(--font-3);
      letter-spacing: var(--ls-sm);
    }
    &.h4 {
      font: var(--font-4);
      letter-spacing: var(--ls-sm);
    }
    &.h5 {
      font: var(--font-5);
      letter-spacing: var(--ls-lg);
    }
    &.h6 {
    }

    // Highlighted span
    .highlighted {
      position: relative;

      &::before {
        content: "";
        position: absolute;
        z-index: -1;
        left: var(--size-4);
        bottom: 10%;
        width: 100%;
        height: 40%;
        background-color: var(--bg-text-highlight);
        opacity: 0.5;
        border-radius: var(--br-xs);
        transform: scaleX(1.05);
      }
    }
  }
</style>
