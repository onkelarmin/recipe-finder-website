---
// Integreations
import { Icon } from "astro-icon/components";

// Types
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  type?: "button" | "submit";
  variant: "nav" | "hero" | "cta" | "card" | "select";
  text?: string;
  icon?: string;
  classes?: string;
}

const { type = "button", variant, text, icon, classes, ...rest } = Astro.props;
---

<button class:list={["btn", variant, classes]} {type} {...rest}>
  {text && <span class="text">{text}</span>}
  {icon && <Icon name={icon} />}
</button>

<style lang="scss">
  .btn {
    width: fit-content;
    display: flex;
    align-items: center;
    gap: var(--size-8);
    text-transform: none;
    text-decoration: none;
    border: none;
    border-radius: var(--br-md);
    transition:
      color var(--trans-default),
      background-color var(--trans-default),
      border-color var(--trans-default);

    &:not(:disabled) {
      cursor: pointer;
    }

    &:focus {
      outline: 0px solid transparent;
    }

    [data-icon] {
      width: var(--size-icon-controls);
      aspect-ratio: 1;
      color: inherit;
    }

    // Variants
    &:is(.nav, .hero, .cta, .card) {
      background-color: var(--btn-default-idle-bg);
      color: var(--btn-default-idle-fg);

      @media (hover: hover) {
        &:hover {
          background-color: var(--btn-default-hover-bg);
          color: var(--btn-default-hover-fg);
        }
      }

      &:active {
        // No pressed state
      }

      &:focus-visible {
        outline: var(--bw-md) solid var(--btn-default-focus-outline);
        outline-offset: var(--bw-lg);
      }
    }

    &.nav {
      padding-inline: var(--size-16);
      padding-block: var(--size-12);
      font: var(--font-5);
      letter-spacing: var(--ls-md);
    }

    &.hero {
      padding-inline: var(--size-32);
      padding-block: var(--size-16);
      font: var(--font-5);
      letter-spacing: var(--ls-md);
    }

    &.cta {
      padding-inline: var(--size-24);
      padding-block: var(--size-16);
      font: var(--font-11);
      letter-spacing: var(--ls-none);
    }

    &.card {
      padding-inline: var(--size-32);
      padding-block: var(--size-12);
      font: var(--font-8);
      letter-spacing: var(--ls-xl);
      border-radius: var(--br-pill);
    }

    &.select {
      padding-inline: var(--size-16);
      padding-block: var(--size-10);
      font: var(--font-7);
      letter-spacing: var(--ls-xl);
      background-color: var(--btn-select-idle-bg);
      color: var(--btn-select-idle-fg);
      border-style: solid;
      border-width: var(--bw-sm);
      border-color: var(--btn-select-idle-border);

      @media (hover: hover) {
        &:hover {
          background-color: var(--btn-select-hover-bg);
          color: var(--btn-select-hover-fg);
          border-color: var(--btn-select-hover-border);
        }
      }

      &:active {
        // No pressed state
      }

      &:focus-visible {
        box-shadow:
          0 0 0 var(--bw-md) var(--btn-select-focus-offset),
          0 0 0 calc(var(--bw-md) * 2) var(--btn-select-focus-outline);
      }
    }
  }
</style>
