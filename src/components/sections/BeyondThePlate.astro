---
// Integrations
import { Image } from "astro:assets";

// Asset imports
import BeyondThePlateImage from "@assets/image-about-beyond-the-plate-large.webp";

// Component imports
import Wrapper from "@components/utilities/Wrapper.astro";
import Heading from "@components/utilities/Heading.astro";
---

<section
  id="beyond-the-plate-section"
  class="pad-sect-lg"
  aria-labelledby="beyond-the-plate-title"
>
  <Wrapper>
    <div class="layout">
      <!-- Content -->
      <div class="content flow-20">
        <Heading
          tag="h2"
          size="h2"
          text="Beyond the plate"
          id="beyond-the-plate-title"
        />
        <div class="flow-12">
          <p>
            We believe food is a catalyst for community and well-being. By
            sharing approachable recipes, we hope to:
          </p>
          <ul>
            <li>Encourage family dinners and social cooking.</li>
            <li>Reduce reliance on single-use packaging and delivery waste.</li>
            <li>
              Spark curiosity about seasonal produce and local agriculture.
            </li>
          </ul>
        </div>
      </div>

      <!-- Visual -->
      <div class="visual br-lg overflow-clip">
        <Image
          src={BeyondThePlateImage}
          alt="In a bright kitchen, a family prepares fresh vegetables, enjoying their time cooking together."
          width={900}
          height={484}
        />
      </div>
    </div>
  </Wrapper>
</section>

<style lang="scss">
  @use "@sass/miscellaneous" as *;

  .layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-cont-xl);

    .content {
      ul li {
        list-style: none;
        display: grid;
        grid-template-columns: 2rem 1fr;

        &::before {
          content: "\2022";
          justify-self: center;
        }
      }
    }

    @include mq(large) {
      flex-direction: row;
      .content {
        flex: 3;
      }

      .visual {
        flex: 4;
        max-width: 46.5rem;
      }
    }
  }
</style>
