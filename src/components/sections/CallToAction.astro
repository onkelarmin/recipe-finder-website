---
// Component imports
import Wrapper from "@components/utilities/Wrapper.astro";
import Heading from "@components/utilities/Heading.astro";
import ButtonLink from "@components/ui/ButtonLink.astro";

// Asset imports
import ForkSvg from "@icons/pattern-fork.svg";
import KnifeSvg from "@icons/pattern-knife.svg";
---

<section aria-labelledby="call-to-action-title">
  <Wrapper>
    <div class="bg-container-cta br-3xl">
      <div class="layout">
        <Heading
          tag="h2"
          size="h2"
          text="Ready to cook smarter?"
          id="call-to-action-title"
        />
        <p>Hit the button, pick a recipe, and get dinner on the table—fast.</p>
        <ButtonLink href="/recipes" variant="cta" text="Browse recipes" />
        <!-- Decorative -->
        <ForkSvg class="fork-svg" />
        <KnifeSvg class="knife-svg" />
      </div>
    </div>
  </Wrapper>
</section>

<style lang="scss">
  @use "@sass/miscellaneous" as *;

  .layout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-radius: inherit;
    overflow: clip;
    padding-block: var(--pad-sect-md);
    padding-inline: var(--size-16);

    p {
      margin-block-start: var(--size-12);
      margin-block-end: var(--size-32-40-40);
    }

    // Decorative
    .fork-svg,
    .knife-svg {
      position: absolute;
      z-index: -1;

      @include mq(medium, max) {
        display: none;
      }
    }

    .fork-svg {
      width: var(--size-icon-fork);
      left: 0;
      bottom: 0;
      translate: -28% 23%;

      @include mq(large) {
        translate: -28% 13%;
      }
    }
    .knife-svg {
      width: var(--size-icon-knife);
      right: 0;
      top: 0;
      translate: 10% -30%;

      @include mq(large) {
        translate: 25% 5%;
      }
    }
  }
</style>
