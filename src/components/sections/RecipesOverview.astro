---
// Integrations
import { getCollection } from "astro:content";

// Component imports
import Wrapper from "@components/utilities/Wrapper.astro";
import FilterMenuButton from "@components/ui/FilterMenuButton.astro";
import FilterMenu from "@components/ui/FilterMenu.astro";
import SearchBar from "@components/ui/SearchBar.astro";
import RecipeCard from "@components/ui/RecipeCard.astro";
import Heading from "@components/utilities/Heading.astro";

// Content collection
const allRecipes = await getCollection("recipes");
---

<section class="pad-sect-end-md" aria-labelledby="recipe-overview-title">
  <Wrapper>
    <Heading
      tag="h2"
      size="h2"
      text="Recipe overview"
      id="recipe-overview-title"
      class="visually-hidden"
    />
    <!-- Controls -->
    <div class="controls">
      <fieldset class="filter-group">
        <legend class="visually-hidden">Filter by: </legend>
        <!-- Menu Buttons -->
        <FilterMenuButton text="Max Prep Time" variant="prep" />
        <FilterMenuButton text="Max Cook Time" variant="cook" />

        <!-- Menus -->
        <FilterMenu variant="prep" options={[0, 5, 10]} />
        <FilterMenu variant="cook" options={[0, 5, 10, 15, 20]} />
      </fieldset>

      <!-- Search bar -->
      <SearchBar />
    </div>

    <!-- Recipes -->
    <ul class="recipe-list">
      {
        allRecipes.map((r) => (
          <li>
            <RecipeCard recipe={r} />
          </li>
        ))
      }
    </ul>
  </Wrapper>
</section>

<style lang="scss">
  @use "@sass/miscellaneous" as *;

  .controls {
    display: flex;
    flex-direction: column;
    gap: var(--size-12);

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: var(--size-12);
      border: none;
    }

    @include mq(medium) {
      flex-direction: row;
      justify-content: space-between;

      .filter-group {
        flex-direction: row;
      }
    }
  }

  .recipe-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--size-32);
    list-style-type: none;
    margin-block-start: var(--size-24);

    @include mq(large) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  // Type imports
  import { isVariant, type Variant } from "@/domain/filters";

  // GSAP
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // Type declarations
  type Filters = {
    [K in Variant]: number | null;
  };

  // Elements
  const header = document.querySelector<HTMLElement>(".site-header");
  const filterMenus = document.querySelectorAll<HTMLDivElement>(".filter-menu");
  const filterGroups = document.querySelectorAll<HTMLFieldSetElement>(
    ".filter-menu > fieldset",
  );
  const allRecipes = document.querySelectorAll<HTMLElement>(".recipe-card");
  const clearButtons =
    document.querySelectorAll<HTMLButtonElement>(".clear-button");

  // Variables
  const filters: Filters = {
    prep: null,
    cook: null,
  };

  // Functions
  function updateFilter(variant: Variant, value: number | null) {
    filters[variant] = value;
  }

  function applyFilters() {
    allRecipes.forEach((recipe) => {
      const prepTime = Number(recipe.dataset.prep ?? Infinity);
      const cookTime = Number(recipe.dataset.cook ?? Infinity);
      const li = recipe.closest("li");

      const shouldHide =
        (filters.prep !== null && prepTime > filters.prep) ||
        (filters.cook !== null && cookTime > filters.cook);

      li?.toggleAttribute("hidden", shouldHide);
    });
  }

  function handleFilterChange(variant: Variant, value: string | null) {
    updateFilter(variant, value === null ? null : Number(value));
    applyFilters();
  }

  // Event listeners
  filterGroups.forEach((el) => {
    el.addEventListener("change", (e) => {
      const target = e.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (target.type !== "radio") return;
      if (!isVariant(target.name)) return;

      handleFilterChange(target.name, target.value);
    });
  });

  clearButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      // update UI
      const variant = btn.dataset.variant;
      if (!variant || !isVariant(variant)) return;

      handleFilterChange(variant, null);

      // Uncheck radio buttons
      btn
        .closest(".filter-menu")
        ?.querySelectorAll<HTMLInputElement>('input[type="radio"]')
        .forEach((i) => {
          i.checked = false;
        });
    });
  });

  // GSAP ("sticky" behaviour of Filter menus)
  filterMenus.forEach((menu) => {
    ScrollTrigger.create({
      trigger: menu,
      start: () => `top ${header?.offsetHeight}`,
      end: "max",
      onEnter: () => menu.classList.add("sticky"),
      onLeaveBack: () => menu.classList.remove("sticky"),
    });
  });
</script>
