---
// Integrations
import { getCollection } from "astro:content";

// Component imports
import Wrapper from "@components/utilities/Wrapper.astro";
import FilterMenuButton from "@components/ui/FilterMenuButton.astro";
import FilterMenu from "@components/ui/FilterMenu.astro";
import SearchBar from "@components/ui/SearchBar.astro";
import RecipeCard from "@components/ui/RecipeCard.astro";
import Heading from "@components/utilities/Heading.astro";

// Content collection
const allRecipes = await getCollection("recipes");
---

<section class="pad-sect-end-md" aria-labelledby="recipe-overview-title">
  <Wrapper>
    <Heading
      tag="h2"
      size="h2"
      text="Recipe overview"
      id="recipe-overview-title"
      class="visually-hidden"
    />
    <!-- Controls -->
    <div class="controls">
      <fieldset class="filter-group">
        <legend class="visually-hidden">Filter by: </legend>
        <!-- Menu Buttons -->
        <FilterMenuButton text="Max Prep Time" variant="prep" />
        <FilterMenuButton text="Max Cook Time" variant="cook" />

        <!-- Menus -->
        <FilterMenu variant="prep" options={[0, 5, 10]} />
        <FilterMenu variant="cook" options={[0, 5, 10, 15, 20]} />
      </fieldset>

      <!-- Search bar -->
      <SearchBar />
    </div>

    <!-- Recipes -->
    <ul class="recipe-list">
      {
        allRecipes.map((r) => (
          <li>
            <RecipeCard recipe={r} />
          </li>
        ))
      }
    </ul>
  </Wrapper>
</section>

<style lang="scss">
  @use "@sass/miscellaneous" as *;

  .controls {
    display: flex;
    flex-direction: column;
    gap: var(--size-12);

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: var(--size-12);
      border: none;
    }

    @include mq(medium) {
      flex-direction: row;
      justify-content: space-between;

      .filter-group {
        flex-direction: row;
      }
    }
  }

  .recipe-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--size-32);
    list-style-type: none;
    margin-block-start: var(--size-24);

    @include mq(large) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  // Type imports
  import { isVariant, type Variant } from "@/domain/filters";

  // GSAP
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // Type declarations
  type Filters = {
    [K in Variant]: number | null;
  };

  // Elements
  const header = document.querySelector<HTMLElement>(".site-header");
  const filterMenus = document.querySelectorAll<HTMLDivElement>(".filter-menu");
  const filterGroups = document.querySelectorAll<HTMLFieldSetElement>(
    ".filter-menu > fieldset",
  );
  const allRecipes = [
    ...document.querySelectorAll<HTMLElement>(".recipe-card"),
  ];
  const clearButtons =
    document.querySelectorAll<HTMLButtonElement>(".clear-button");
  const searchBar = document.querySelector<HTMLInputElement>("#search-bar");

  // Variables
  const filters: Filters = {
    prep: null,
    cook: null,
  };

  const search = {
    query: "",
  };

  // Recipe-index
  const recipeIndex = allRecipes.map((recipe) => {
    const title = recipe;
    document
      .querySelector<HTMLHeadingElement>(".heading")
      ?.textContent?.toLowerCase() ?? "";
    const ingredients = recipe.dataset.ingredients
      ? JSON.parse(recipe.dataset.ingredients).join(" ").toLowerCase()
      : "";

    return {
      element: recipe,
      li: recipe.closest("li"),
      searchText: `${title} ${ingredients}`,
      prep: Number(recipe.dataset.prep),
      cook: Number(recipe.dataset.cook),
    };
  });

  // Determine whether recipe should be shown
  function shouldShowRecipe(recipe: (typeof recipeIndex)[number]) {
    // Filter logic
    if (filters.prep !== null && recipe.prep > filters.prep) return false;
    if (filters.cook !== null && recipe.cook > filters.cook) return false;

    // Search logic
    if (search.query && !recipe.searchText.includes(search.query)) return false;
    return true;
  }

  // Render
  function renderRecipes() {
    recipeIndex.forEach((recipe) => {
      recipe.li?.toggleAttribute("hidden", !shouldShowRecipe(recipe));
    });
  }

  // Filter-groups
  filterGroups.forEach((el) => {
    el.addEventListener("change", (e) => {
      // Guard clauses
      const target = e.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (target.type !== "radio") return;
      if (!isVariant(target.name)) return;

      const variant = target.name;
      const value = target.value;

      filters[variant] = value !== null ? Number(value) : null;

      renderRecipes();
    });
  });

  // Searchbar
  searchBar?.addEventListener("input", (e) => {
    // Guard clauses
    if (!(e.currentTarget instanceof HTMLInputElement)) return;

    search.query = e.currentTarget.value.trim().toLowerCase();

    renderRecipes();
  });

  // Clear buttons
  clearButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      // update UI
      const variant = btn.dataset.variant;
      if (!variant || !isVariant(variant)) return;

      filters[variant] = null;

      renderRecipes();

      // Uncheck radio buttons
      btn
        .closest(".filter-menu")
        ?.querySelectorAll<HTMLInputElement>('input[type="radio"]')
        .forEach((i) => {
          i.checked = false;
        });
    });
  });

  // GSAP ("sticky" behaviour of Filter menus)
  filterMenus.forEach((menu) => {
    ScrollTrigger.create({
      trigger: menu,
      start: () => `top ${header?.offsetHeight}`,
      end: "max",
      onEnter: () => menu.classList.add("sticky"),
      onLeaveBack: () => menu.classList.remove("sticky"),
    });
  });
</script>
