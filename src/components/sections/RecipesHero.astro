---
import Wrapper from "@/components/utilities/Wrapper.astro";
import Heading from "@/components/utilities/Heading.astro";
---

<section
  class="pad-sect-start-sm pad-sect-end-xs"
  aria-labelledby="recipes-hero-title"
>
  <Wrapper>
    <div class="flow-12 text-center-large">
      <Heading
        tag="h1"
        size="h2"
        text="Explore our simple, healthy recipes"
        id="recipes-hero-title"
      />
      <p>
        Discover eight quick, whole-food dishes that fit real-life schedules and
        taste amazing. Use the search bar to find a recipe by name or
        ingredient, or simply scroll the list and let something delicious catch
        your eye.
      </p>
    </div>
  </Wrapper>
</section>
