---
// Import Site data
import { sitePages } from "@/data/siteData";

// Layout import
import MainLayout from "@layouts/MainLayout.astro";

// Component imports
import HeroAbout from "@/components/sections/HeroAbout.astro";
import WhyWeExist from "@/components/sections/WhyWeExist.astro";
import Philosophy from "@/components/sections/Philosophy.astro";
import BeyondThePlate from "@/components/sections/BeyondThePlate.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

const page = sitePages.about;
---

<MainLayout
  title={page.title}
  description={page.description}
  ogImage={page.ogImage}
>
  <HeroAbout />
  <WhyWeExist />
  <Philosophy />
  <BeyondThePlate />
  <CallToAction />
</MainLayout>
