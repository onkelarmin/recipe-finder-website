---
// Import Site data
import { sitePages } from "@/data/siteData";

// Layout import
import MainLayout from "@layouts/MainLayout.astro";

// Component imports
import RecipesHero from "@/components/sections/RecipesHero.astro";
import RecipesOverview from "@/components/sections/RecipesOverview.astro";

const page = sitePages.recipes;
---

<MainLayout
  title={page.title}
  description={page.description}
  ogImage={page.ogImage}
>
  <RecipesHero />
  <RecipesOverview />
</MainLayout>
